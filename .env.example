# Identifiants eBay Developer (application "Production" ou "Sandbox")
# https://developer.ebay.com/my/keys
EBAY_APP_ID=your-client-id
EBAY_CERT_ID=your-client-secret

# URL du webhook Discord (Paramètres du salon > Intégrations > Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Seuil de bonne affaire : prix annonce <= reference * PRICE_THRESHOLD (0.7 = -30%)
PRICE_THRESHOLD=0.7

# Intervalle de polling en expression cron (defaut: toutes les 10 minutes)
CRON_SCHEDULE=*/10 * * * *

# Chemin du fichier SQLite
DB_PATH=./data/watcher.sqlite

# Chemin de la watchlist
WATCHLIST_PATH=./watchlist.json
