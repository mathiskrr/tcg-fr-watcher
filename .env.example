# Identifiants eBay Developer (application "Production" ou "Sandbox")
# https://developer.ebay.com/my/keys
EBAY_APP_ID=your-client-id
EBAY_CERT_ID=your-client-secret

# URL du webhook Discord (Paramètres du salon > Intégrations > Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Seuil de bonne affaire : prix annonce <= reference * PRICE_THRESHOLD (0.7 = -30%)
PRICE_THRESHOLD=0.7

# Intervalle de polling en expression cron (defaut: toutes les 10 minutes)
CRON_SCHEDULE=*/10 * * * *

# Chemin du fichier SQLite
DB_PATH=./data/watcher.sqlite

# Chemin de la watchlist
WATCHLIST_PATH=./watchlist.json

# Cookie de session Vinted (JWT), optionnel mais recommande : sans lui, l'API interne
# Vinted repond generalement HTTP 401 invalid_authentication_token.
# Recuperation manuelle (pas d'API officielle) :
#   1. connecte-toi sur https://www.vinted.fr
#   2. ouvre les DevTools du navigateur (F12) > onglet Application (Chrome) ou
#      Stockage (Firefox) > Cookies > https://www.vinted.fr
#   3. copie la valeur du cookie "access_token_web"
# C'est un JWT de courte duree (quelques heures) : le bot decode sa date d'expiration
# et logge un avertissement clair quand il faut le renouveler (voir src/vinted.ts).
VINTED_ACCESS_TOKEN_WEB=
