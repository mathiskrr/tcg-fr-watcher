# Identifiants eBay Developer (application "Production" ou "Sandbox")
# https://developer.ebay.com/my/keys
EBAY_APP_ID=your-client-id
EBAY_CERT_ID=your-client-secret

# URL du webhook Discord (Paramètres du salon > Intégrations > Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy

# Intervalle de polling en expression cron (defaut: toutes les 10 minutes)
CRON_SCHEDULE=*/10 * * * *

# Chemin du fichier SQLite
DB_PATH=./data/watcher.sqlite

# Chemin de la watchlist
WATCHLIST_PATH=./watchlist.json

# Sources actives, separees par des virgules (valeurs valides: ebay, vinted).
# Par defaut (non defini) : toutes les sources sont actives.
# Utile par ex. pour tourner sur Vinted seul en attendant une approbation eBay,
# sans avoir besoin de renseigner EBAY_APP_ID/EBAY_CERT_ID (non requis si "ebay" absent).
ENABLED_SOURCES=ebay,vinted

# Cookie de session Vinted (JWT), optionnel mais recommande : sans lui, l'API interne
# Vinted repond generalement HTTP 401 invalid_authentication_token.
# Recuperation manuelle (pas d'API officielle) :
#   1. connecte-toi sur https://www.vinted.fr
#   2. ouvre les DevTools du navigateur (F12) > onglet Application (Chrome) ou
#      Stockage (Firefox) > Cookies > https://www.vinted.fr
#   3. copie la valeur du cookie "access_token_web"
# C'est un JWT de courte duree (quelques heures) : le bot decode sa date d'expiration
# et logge un avertissement clair quand il faut le renouveler (voir src/vinted.ts).
VINTED_ACCESS_TOKEN_WEB=

# Serveur d'admin HTTP minimal (voir README "Serveur d'admin") : permet de renouveler le
# token Vinted a distance (telephone, PC) sans SSH ni redemarrage du bot.
# Optionnel : le serveur ne demarre PAS DU TOUT si ADMIN_SECRET est absent (par defaut,
# desactive), pour ne jamais exposer un endpoint ouvert par accident.
#
# ADMIN_SECRET : genere un secret fort et unique, par exemple avec :
#   openssl rand -hex 32
# Ne JAMAIS reutiliser un mot de passe existant ni un secret court/devinable : c'est la
# seule protection de cet endpoint, expose sur Internet si le port est ouvert.
ADMIN_PORT=3939
ADMIN_SECRET=

# Renouvellement AUTOMATIQUE du token Vinted par login programmatique (Playwright + Chromium
# headless), en complement du systeme manuel ci-dessus (voir README "Renouvellement
# automatique du token"). Optionnel : les DEUX variables doivent etre presentes pour
# l'activer, sinon fallback silencieux sur le renouvellement manuel (POST /token).
#
# ATTENTION - RISQUES A LIRE AVANT D'ACTIVER :
#   - Ce sont tes VRAIS identifiants Vinted, stockes EN CLAIR dans ce fichier sur le serveur.
#     Un .env jamais commite (deja dans .gitignore) et des permissions restreintes sont le
#     minimum : sur le serveur, apres avoir rempli ce fichier, lance
#       chmod 600 .env
#     pour qu'il ne soit lisible/modifiable que par l'utilisateur qui fait tourner le bot.
#   - Une connexion automatisee recurrente (toutes les 90 min, 24/7) peut etre detectee comme
#     un bot par Vinted et risque de faire flaguer/bannir le compte -- c'est un compromis
#     assume, pas une garantie sans risque. En cas de captcha/verification supplementaire, le
#     bot n'insiste PAS et retombe sur le renouvellement manuel (voir src/vintedAuth.ts).
#   - Si tu preferes eviter ce risque, laisse ces deux variables vides : le renouvellement
#     manuel (POST /token, voir "Serveur d'admin") continue de fonctionner normalement.
VINTED_EMAIL=
VINTED_PASSWORD=
